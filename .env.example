POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
CORS_ORIGINS=http://localhost:5173

# Only needed if the Web UI must call a backend on a separate origin (e.g. a
# split deployment). Local development doesn't need this -- the Vite dev
# server proxies /api to the backend, so the Web UI uses a same-origin
# relative URL by default.
VITE_API_URL=

# Required once, to create the first Adult via POST /api/auth/setup.
# Generate a real random value locally; never commit an actual secret here.
INITIAL_SETUP_TOKEN=

# Required to run the telegram-bot service (Issue #23). Get one from
# @BotFather on Telegram; never commit a real token here.
TELEGRAM_BOT_TOKEN=
